<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/cameraStatus"
            style="@style/StatusTextStyle"
            android:text="@string/initializing_camera"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/mediapipeStatus"
            style="@style/StatusTextStyle"
            android:text="@string/initializing_mediapipe"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/mqttStatus"
            style="@style/StatusTextStyle"
            android:text="@string/connecting_mqtt" />
    </LinearLayout>

    <!-- 选项名（扫描态显示） -->
    <TextView
        android:id="@+id/optionNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mainButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusLayout" />

    <!-- 底部信息区域 -->
    <LinearLayout
        android:id="@+id/bottomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/gazeStatus"
            style="@style/StatusTextStyle"
            android:text="@string/no_gaze_detected"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/confidenceText"
            style="@style/StatusTextStyle"
            android:text="置信度: 0%"
            android:textSize="14sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/deviceIdText"
            style="@style/StatusTextStyle"
            android:text="设备ID: 未设置"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/menuOptionText"
            style="@style/StatusTextStyle"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 单按钮 - 占满中央区域 -->
    <TextView
        android:id="@+id/mainButton"
        style="@style/LargeButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:text="是"
        android:background="@drawable/btn_yes_normal"
        app:layout_constraintTop_toBottomOf="@id/optionNameText"
        app:layout_constraintBottom_toTopOf="@id/dwellProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 进度条（扫描/确认态显示） -->
    <ProgressBar
        android:id="@+id/dwellProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:max="100"
        android:progress="100"
        android:visibility="gone"
        android:progressDrawable="@drawable/progress_bar_gaze"
        app:layout_constraintBottom_toTopOf="@id/bottomInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 角色切换按钮（左上角） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/roleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:src="@android:drawable/ic_menu_manage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 校准按钮（右上角） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/settingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:src="@android:drawable/ic_menu_preferences"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 调试叠加层（默认隐藏，双击设备ID切换） -->
    <include layout="@layout/debug_panel" />
</androidx.constraintlayout.widget.ConstraintLayout>
